# Variables d'environnement du projet — COPIER en .env et renseigner.
# Le fichier .env ne doit JAMAIS être versionné (voir .gitignore).

# Clé de pseudonymisation (HMAC-SHA256 des identifiants clients).
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Attention : changer cette clé change tous les pseudonymes et rompt la
# correspondance avec les données déjà stockées. Une rotation suppose un
# versionnement des clés et une reprise planifiée (cf. docs/compliance/securite-anssi.md).
CHURN_PSEUDONYM_KEY=

# Airflow
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__DAGS_FOLDER=./airflow/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
